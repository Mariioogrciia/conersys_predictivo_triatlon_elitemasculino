# ============================================================================
# .gitignore - PROYECTO TFM TRIATLÓN (FETRI)
# ============================================================================

# --- Archivos de Datos (Evitar subir datasets grandes o con datos sensibles/GDPR) ---
data/
*.xlsx
*.xls
*.csv
*.db
*.sqlite
# Excluir archivos JSON temporales o grandes de datos (pero permitir JSONs de configuración)
calendar_cities_db.json
club_coords_cache.json
Campeonatos/*.json

# --- Entorno Virtual de Python ---
venv/
.venv/
env/
ENV/
bin/
lib/
include/
pip-selfcheck.json

# --- Compilados y Caché de Python ---
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ipynb_checkpoints/

# --- Configuraciones del IDE y Sistema ---
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp
.DS_Store
Thumbs.db
.~lock.*

# --- Entornos y Credenciales ---
.env

